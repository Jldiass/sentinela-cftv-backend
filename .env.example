POSTGRES_DB=cftv
POSTGRES_USER=cftv
POSTGRES_PASSWORD=troque-esta-senha
PUBLIC_RTMP_BASE_URL=rtmp://localhost:1935
PUBLIC_HLS_BASE_URL=http://localhost:8888
PUBLIC_PLAYBACK_BASE_URL=http://localhost:9996
RECORD_DELETE_AFTER=1h
CAMERA_LIMIT=8
UNSTABLE_AFTER_SECONDS=20
STATUS_POLL_SECONDS=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
AUTH_JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
AUTH_DEBUG_RETURN_RESET_TOKEN=false
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare R2 (opcional). Sem essas variáveis, as gravações continuam
# servidas pelo playback local do MediaMTX. Gere as chaves em
# Cloudflare Dashboard > R2 > Manage API Tokens; nunca commite os valores reais.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
