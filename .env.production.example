# DNS: crie um registro A apontando este domínio para o IP público do servidor.
PUBLIC_DOMAIN=cftv.seudominio.com.br
CADDY_ACME_EMAIL=voce@seudominio.com.br

POSTGRES_DB=cftv
POSTGRES_USER=cftv
# Use uma senha longa com letras e números; ela é inserida na URL interna do banco.
POSTGRES_PASSWORD=TroquePorUmaSenhaLongaUnica2026
POSTGRES_DATA_PATH=/srv/sentinela/postgres
RECORDINGS_PATH=/srv/sentinela/recordings
RECORD_DELETE_AFTER=1h

# Gere o hash conforme DEPLOY.md e mantenha as aspas simples.
CADDY_ADMIN_USER=operador
CADDY_ADMIN_PASSWORD_HASH='$2a$14$substitua.pelo.hash.gerado'

CAMERA_LIMIT=8
UNSTABLE_AFTER_SECONDS=20
CORS_ORIGINS=https://cftv.seudominio.com.br
